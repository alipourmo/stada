{
  "outputDirectory": "public",
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.4" }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(index|login|logout|pomodoro|tests|leaderboard|reports|class)\\.php", "dest": "/api/$1.php" }
  ]
}
