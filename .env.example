# Supabase PostgreSQL connection (server-only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT cookie signing secret (generate a random 32+ byte hex string)
