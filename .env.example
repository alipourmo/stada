# Supabase Database (Server-side only — never expose SERVICE_ROLE_KEY to client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication JWT signing secret (min 32 random chars)
AUTH_SECRET=replace-with-a-strong-random-32-char-secret

# Default Exam Date (YYYY-MM-DD, Asia/Tehran)
EXAM_DATE=2027-05-06
